# Port the HTTP server listens on inside the container.
PORT=8080

# --- mqtt ---

# Broker URL trmnl and spotify publish to, e.g. tcp://mosquitto:1883, or
# ssl://host:8883 for TLS. Required - trmnl's text/image push has no
# other delivery path (see the trmnl section below), and spotify's
# current-track changes are published here too.
MQTT_BROKER_URL=

# Only sent if non-empty - most brokers also allow anonymous connections.
MQTT_USERNAME=
MQTT_PASSWORD=

# Topic spotify's current track is published to, retained, whenever it
# changes. trmnl's queues have their own fixed topics (trmnl/text,
# trmnl/image) and aren't configurable here.
MQTT_TOPIC=spotify/current

# --- trmnl (TRMNL Polling-strategy plugin API) ---

# POST /api/trmnl/text and POST /api/trmnl/image publish to mqtt
# (MQTT_BROKER_URL above); this server's own queue consumer picks the
# message up and holds it in redis (REDIS_URL below) for TRMNL to fetch.
# Configure both TRMNL private plugins with strategy "Polling" (verb GET)
# pointed at this server's /api/trmnl/text and /api/trmnl/image - see
# README.md for the one-time setup steps. No env var needed for this;
# nothing here to fill in.

# Public base URL this service is reachable at, used to build links to
# images you upload via POST /api/trmnl/image. Only required if you plan
# to upload images rather than passing an already-public image_url.
# Example: https://api.example.com
PUBLIC_BASE_URL=

# Directory (inside the container) where uploaded images are stored.
# Matches the volume mount in docker-compose.yml - leave as-is unless you
# also change the volume.
DATA_DIR=/data

# --- homeassistant (Home Assistant light API) ---

# Base URL of your Home Assistant instance (e.g. http://homeassistant.local:8123
# or https://your-instance.ui.nabu.casa). No trailing slash.
HOME_ASSISTANT_BASE_URL=

# Long-Lived Access Token for Home Assistant. Create one from your HA user
# profile -> Security -> Long-Lived Access Tokens -> Create Token.
HOME_ASSISTANT_TOKEN=

# Entity ID of the light (or light group) this service controls, e.g.
# light.living_room or light.all_lights.
HOME_ASSISTANT_LIGHT_GROUP=

# --- spotify (Spotify playback API) ---

# Client ID and secret of a Spotify app you create once at
# https://developer.spotify.com/dashboard (Create app -> enable the
# Web API).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OAuth callback URL, i.e. the public URL of this service's
# /api/spotify/setup endpoint (e.g. https://api.example.com/api/spotify/setup).
# Must exactly match a Redirect URI configured on the Spotify app.
SPOTIFY_REDIRECT_URI=

# Redis connection URL. Stores spotify's OAuth tokens, the github cache,
# and trmnl's pending-message queues. The default points at the
# docker-compose redis service; adjust if you run your own.
REDIS_URL=redis://redis:6379/0

# --- github (pinned repos + contributions) ---

# GitHub username whose pinned repositories GET /api/github/pinned shows.
GITHUB_USERNAME=

# Personal access token (classic or fine-grained) used to authenticate to
# GitHub's GraphQL API. GET /api/github/contributions always reflects
# whichever account this token belongs to, since it reads the GraphQL
# `viewer` field.
GITHUB_TOKEN=

# --- shared ---

# Comma-separated list of CIDRs for reverse proxies you trust to set
# X-Forwarded-For (e.g. your ingress/LB's pod or VPC ranges) - no spaces
# after commas. The client IP used for logging is read from the
# right-most X-Forwarded-For entry that isn't inside one of these ranges.
# Leave blank if the service is reachable directly (no reverse proxy in
# front) - the TCP connection's source IP is used instead, and
# X-Forwarded-For is ignored to prevent spoofing.
TRUSTED_PROXY_CIDRS=

# Comma-separated list of origins allowed to make cross-origin requests
# (e.g. https://app.example.com) - no spaces after commas. Leave blank to
# use the default: any ok8.sh origin (apex or subdomain, e.g.
# https://foo.ok8.sh) or any origin on port 3000 (local dev, any
# host/scheme).
CORS_ALLOWED_ORIGINS=
