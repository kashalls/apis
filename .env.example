# Port the HTTP server listens on inside the container.
PORT=8080

# Discord bot token (Bot application, not a user token). Needs the
# "Presence Intent" and "Server Members Intent" privileged intents enabled
# in the Discord Developer Portal, and must be invited to a server you're
# also in.
DISCORD_BOT_TOKEN=

# Your Discord user ID (right-click your name in Discord with Developer
# Mode enabled -> Copy User ID). This is the only user this API will ever
# report presence for.
DISCORD_USER_ID=

# Optional: restrict presence lookups to one specific shared guild ID. Leave
# blank to use whichever shared guild the bot sees the user in first.
DISCORD_GUILD_ID=

# Webhook URL for a TRMNL private plugin you create once in the TRMNL
# dashboard (Plugins -> Private Plugin -> copy the "Webhook URL"). See
# README.md for the one-time setup steps.
TRMNL_WEBHOOK_URL=

# Public base URL this service is reachable at, used to build links to
# images you upload via POST /api/trmnl/image. Only required if you plan to
# upload images rather than passing an already-public image_url. Example:
# https://juno.example.com
PUBLIC_BASE_URL=

# Directory (inside the container) where uploaded images are stored.
# Matches the volume mount in docker-compose.yml - leave as-is unless you
# also change the volume.
DATA_DIR=/data
